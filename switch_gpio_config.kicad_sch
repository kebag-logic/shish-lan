		)
		(uuid "dcd1491e-3246-4dbd-b0d9-df7a6b0484ab")
	)
	(text "*0: Disable 2.5G detect\n1: Enable 2.5G detect"
		(exclude_from_sim no)
		(at 136.906 71.882 0)
