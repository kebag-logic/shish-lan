		(uuid "efa665de-9322-4d26-a230-21d07c94d0d3")
	)
	(text "0: Mode A (2x RGMII, 1-2x SGMII)\n1: Mode B (1x QSGMII, 0x SGMII, 0-1x RGMII)\n2: Mode C (2x RGMII, 0x SGMII)\n*3: Mode D (0-1x RGMII, 0-2x SGMII)"
		(exclude_from_sim no)
		(at 173.99 104.648 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f7e284df-abcd-4c7d-b07f-819c617c6315")
	)
	(text "Boot Mode Selector\nNote: Unmanaged modes are  selected using\noptions 3, 4,  5, 6, or 7.\n0: No boot.\n1: RESERVED\n2: RESERVED\n*3: ROM boot.\n4: ROM + I2C table boot.\n5: ROM + SPI table boot.\n6: ROM + VRAP port 5 boot. \n7: ROM + VRAP port 7 boot. "
		(exclude_from_sim no)
		(at 15.494 33.782 0)
		(effects
