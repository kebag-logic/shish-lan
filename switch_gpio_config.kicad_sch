	)
	(text "*0: GPIOs will be used \nto control SFP signals\n1: SGPIOS will be used \nto control SFP signals"
		(exclude_from_sim no)
		(at 136.906 135.128 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c1301a1-aff9-410d-a0f8-ace553d68440")
	)
	(text "Enables a 125 MHz reference clock input to SerDes\nNote: If SD_125M is strapped high, SGPIO_EN must \nbe strapped low."
		(exclude_from_sim no)
		(at 14.478 162.814 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2e14d243-70e5-4335-ad74-5a35ddbfe7bd")
	)
	(text "0: Single color mode (one LED signaling\nlink-up and one led signaling activity)\n*1: Tri-color mode (two LEDs to indicate\nlink-up with different color depending \non link speed, LEDs blinking with activity)"
		(exclude_from_sim no)
		(at 87.122 161.036 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "30203761-6e40-4783-93e7-6c21a36c173f")
	)
	(text "*0: 16-bit addressing\n1: 8-bit addressing"
		(exclude_from_sim no)
		(at 137.16 103.378 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "378deec5-e24e-431e-ad1f-967f182b40c2")
	)
	(text "Management Interface Mode Selector\n0: UART CLI\n1: I2C client\n*2: MIIM client\n3: SPI client"
