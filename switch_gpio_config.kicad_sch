	)
	(text "Note: If JTAG is enabled, configuration strap BOOT_MODE0 selects:\n0: DFT TAP controller\n1: SerDes TAP controller\n\n*0: Disable JTAG\n1: Enable JTAG"
		(exclude_from_sim no)
		(at 15.24 122.428 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cd3c97ec-8ec0-49fe-a664-10b179582bc1")
	)
	(text "Each strap number controls a \ncorresponding RGMII interface number.\n*0: RGMII\n1: RMII"
		(exclude_from_sim no)
		(at 173.99 69.088 0)
		(effects
			(font
